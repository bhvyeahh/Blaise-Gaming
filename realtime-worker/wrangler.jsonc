{
  "name": "banterbox-realtime",
  "main": "src/index.mjs",
  "compatibility_date": "2026-01-01",
  "durable_objects": { "bindings": [{"name":"ROOMS","class_name":"GameRoom"}] },
  "migrations": [{"tag":"v1","new_sqlite_classes":["GameRoom"]}],
  "vars": {
  "ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000,https://banterbox.vercel.app,https://blaise-gaming-git-develop-banterbox-mvp-bhvyeahhs-projects.vercel.app"
},
  "ratelimits": [
    {"name":"CREATE_LIMIT","namespace_id":"71001","simple":{"limit":5,"period":60}},
    {"name":"ACCESS_LIMIT","namespace_id":"71002","simple":{"limit":30,"period":60}}
  ]
}
